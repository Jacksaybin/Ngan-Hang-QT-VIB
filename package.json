{
  "name": "vib-demo-telegram-relay",
  "version": "1.0.0",
  "description": "Demo Express server to accept card block requests and OTP, forward to Telegram Bot",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "echo \"No build step for this project\"",
    "bild": "npm run build",
    "test": "jest --runInBand",
    "coverage": "nyc --reporter=lcov --reporter=text npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "lint:fast": "eslint server.js test --ext .js --fix",
    "dev": "nodemon server.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:list": "pm2 ls"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "form-data": "^4.0.4",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.1",
    "supertest": "^6.2.4",
    "nock": "^13.3.0",
    "eslint": "^8.50.0",
    "prettier": "^2.8.8",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-config-prettier": "^8.8.0",
    "nyc": "^15.1.0",
    "cross-env": "^7.0.3"
  }
}