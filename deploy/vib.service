[Unit]
Description=VIB Next.js Docker Compose
After=network-online.target docker.service
Wants=network-online.target

[Service]
# Run as a long-running service which ensures Docker Compose stack is present
Type=simple
# Path to the project on the VPS; edit this to match your deployment location
WorkingDirectory=/home/ubuntu/vib-app

# Load environment variables from .env.production (optional)
EnvironmentFile=-/home/ubuntu/vib-app/.env.production

# Only start if the compose file exists
ConditionPathExists=/home/ubuntu/vib-app/docker-compose.prod.yml

# Ensure Docker Compose stack is started. Use full path to docker binary on VPS if different.
ExecStartPre=/bin/sleep 1
ExecStartPre=/usr/bin/docker --version
ExecStartPre=/usr/bin/docker compose -f /home/ubuntu/vib-app/docker-compose.prod.yml pull --ignore-pull-failures
ExecStart=/usr/bin/docker compose -f /home/ubuntu/vib-app/docker-compose.prod.yml up -d
ExecStop=/usr/bin/docker compose -f /home/ubuntu/vib-app/docker-compose.prod.yml down
ExecReload=/usr/bin/docker compose -f /home/ubuntu/vib-app/docker-compose.prod.yml pull && /usr/bin/docker compose -f /home/ubuntu/vib-app/docker-compose.prod.yml up -d

# If the compose stack fails, always try to restart the service
Restart=always
RestartSec=5

# Give containers time to start/stop
TimeoutStartSec=120
TimeoutStopSec=60

# It's recommended to run this as a non-root user (set 'User=' to ubuntu or a deploy user)
# Example: User=ubuntu

[Install]
WantedBy=multi-user.target
