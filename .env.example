# Core service
PORT=3000
NODE_ENV=production

# Telegram Bot credentials (bắt buộc)
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
CHAT_ID=-1001234567890

# HMAC protection
HMAC_KEY=change_me_long_random_hex
# REQUIRE_HMAC=1            # Bật xác thực HMAC (production nếu có backend ký)

# Storage (Redis optional cho server.js variant)
# REDIS_URL=redis://localhost:6379

# Debug / Demo flags (Chỉ dùng trong DEV - KHÔNG bật production)
# DEBUG_RETURN_OTP=1        # Trả OTP về client để test nhanh
# DEMO_STATIC_OTP=1         # Luôn sinh OTP 123456
# DEV_ALLOW_ENVINFO=1       # Mở endpoint /_envinfo

# Future dual key rotation (chưa áp dụng trong code hiện tại)
# HMAC_KEY_NEXT=
